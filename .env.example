# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，密钥只进 .env。

# ---- LLM（OpenAI 兼容接口，planner/judge 共用）----
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=60

# ---- Halo 靶子（scripts/up.sh 会读取；密码留空则自动生成并写回 .env）----
HALO_BASE_URL=http://localhost:8090
HALO_ADMIN_USER=admin
HALO_ADMIN_PASSWORD=

# ---- 镜像与执行器 ----
HALO_IMAGE=registry.fit2cloud.com/halo/halo:2.20
HEADLESS=1
STEP_TIMEOUT_MS=8000
GOTO_TIMEOUT_MS=20000
# 屏蔽被测应用的外联域名（如 Halo 版本检查 release-checker.halo.run）。
# 这些调用是否成功取决于外网，会让"新版本可用"横幅时有时无导致用例 flaky。
# 留空关闭屏蔽。
BLOCK_EXTERNAL_HOSTS=release-checker.halo.run,www.halo.run,releases.halo.run
