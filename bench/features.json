  {
   "id": "publish-post",
   "title": "新建并发布文章",
   "description": "登录后在文章编辑器新建一篇文章并发布，发布后前台首页能看到这篇文章",
   "priority": "P0",
   "fault": {
    "url_regex": "/apis/api\\.console\\.halo\\.run/v1alpha1/posts/[^/]+/publish",
    "method": "PUT",
    "status": 500
   },
   "reference": {
    "id": "ref-publish-post",
    "title": "新建并发布文章",
    "priority": "P0",
    "feature_id": "publish-post",
    "preconditions": [
     "Halo 已启动并初始化管理员（凭据在 .env）"
    ],
    "steps": [
     {
      "action": "goto",
      "url": "{{BASE_URL}}/login"
     },
     {
      "action": "fill",
      "selector": "role=textbox[name=\"用户名\"]",
      "value": "{{ADMIN_USER}}"
     },
     {
      "action": "fill",
      "selector": "role=textbox[name=\"密码\"]",
      "value": "{{ADMIN_PASSWORD}}"
     },
     {
      "action": "click",
      "selector": "role=button[name=\"登录\"]"
     },
     {
      "action": "wait_for",
      "text": "Administrator"
     },
     {
      "action": "goto",
      "url": "{{BASE_URL}}/console/posts/editor"
     },
     {
      "action": "fill",
      "selector": "role=textbox[name=\"请输入标题\"]",
      "value": "基准文章 {{RUN_ID}}"
     },
     {
      "action": "fill",
      "selector": "[contenteditable=\"true\"]",
      "value": "基准测试自动创建的文章。"
     },
     {
      "action": "click",
      "selector": "role=button[name=\"发布\"]"
     },
     {
      "action": "wait_for",
      "text": "文章设置"
     },
     {
      "action": "click",
      "selector": "role=dialog >> role=button[name=\"发布\"]"
     },
     {
      "action": "wait_for",
      "text": "发布成功"
     },
     {
      "action": "goto",
      "url": "{{BASE_URL}}/"
     },
     {
      "action": "assert_text",
      "text": "基准文章 {{RUN_ID}}"
     }
    ],
    "expected": [
     "控制台提示发布成功",
     "前台首页出现新文章标题"
    ]
   }
  },
