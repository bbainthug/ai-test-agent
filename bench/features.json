{
 "target": "halo 2.20 (theme-earth)",
 "features": [
  {
   "id": "login",
   "title": "管理员登录",
   "description": "管理员在登录页输入账号密码登录，登录成功后进入个人中心",
   "priority": "P0",
   "fault": {
    "url_regex": "/login(\\?|$)",
    "method": "POST",
    "status": 500
   },
   "reference": {
    "id": "ref-login",
    "title": "管理员登录",
    "priority": "P0",
    "feature_id": "login",
    "preconditions": [
     "Halo 已启动并初始化管理员（凭据在 .env）"
    ],
    "steps": [
     {
      "action": "goto",
      "url": "{{BASE_URL}}/login"
     },
     {
      "action": "fill",
      "selector": "role=textbox[name=\"用户名\"]",
      "value": "{{ADMIN_USER}}"
     },
     {
      "action": "fill",
      "selector": "role=textbox[name=\"密码\"]",
      "value": "{{ADMIN_PASSWORD}}"
     },
     {
      "action": "click",
      "selector": "role=button[name=\"登录\"]"
     },
     {
      "action": "wait_for",
      "text": "Administrator"
     },
     {
      "action": "assert_url",
      "url": "/uc"
     }
    ],
    "expected": [
     "登录后跳转到个人中心（URL 包含 /uc）",
     "页面显示当前用户 Administrator"
    ]
   }
  },
  {
   "id": "notification-list",
